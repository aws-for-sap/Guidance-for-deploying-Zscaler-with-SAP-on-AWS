{
  "name": "cdk-zpa-connector",
  "version": "1.0.0",
  "description": "AWS CDK app for deploying Zscaler ZPA App Connectors (HA, 2-AZ, ASG, Secrets Manager, weekly sequential patching, CloudWatch monitoring)",
  "bin": {
    "cdk-zpa-connector": "bin/cdk-zpa-connector.ts"
  },
  "scripts": {
    "build": "tsc",
    "synth": "cdk synth --strict",
    "diff": "cdk diff",
    "deploy": "cdk deploy",
    "test": "echo \"no unit tests configured\" && exit 0"
  },
  "devDependencies": {
    "@types/node": "22.7.4",
    "aws-cdk": "2.1148.0",
    "tsx": "4.23.15",
    "typescript": "5.6.2"
  },
  "dependencies": {
    "aws-cdk-lib": "2.275.0",
    "cdk-nag": "2.38.2",
    "constructs": "10.8.1"
  },
  "overrides": {
    "minimatch": ">=9.0.5",
    "brace-expansion": ">=2.0.2",
    "ajv": ">=8.17.1",
    "esbuild": ">=0.25.0"
  }
}
